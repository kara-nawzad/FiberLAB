+}
+
+.landing-nav-links > a:hover,
+.landing-preset-menu > summary:hover {
+  color: var(--landing-cobalt);
+}
+
+.landing-preset-menu {
+  position: relative;
+}
+
+.landing-preset-menu > summary {
+  cursor: pointer;
+  list-style: none;
+}
+
+.landing-preset-menu > summary::-webkit-details-marker {
