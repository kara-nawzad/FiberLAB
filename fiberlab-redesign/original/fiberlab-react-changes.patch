+        </div>
+        <figcaption className="px-2.5 pb-2 pt-1.5">
+          <div className="text-[11px] font-semibold leading-snug text-noc-100">{profile.modelName}</div>
+          <div className="mt-0.5 text-[8px] uppercase tracking-[0.1em] text-noc-500">{profile.vendorCategory}</div>
+          {configurationLabel ? (
+            <div className="mt-0.5 truncate font-mono text-[9px] text-sky-300" title={configurationLabel}>
+              {configurationLabel}
+            </div>
+          ) : null}
+          <div className="mt-1 text-[10px] leading-relaxed text-noc-400">{profile.description}</div>
+          <div className="mt-1.5 flex items-start gap-1 text-[9px] leading-snug text-amber-900">
+            <Info size={10} className="mt-px shrink-0" />
+            <span>Illustrative hardware reference—not a product photograph or exact vendor model.</span>
+          </div>
+        </figcaption>
+      </figure>
+
+      <div className="space-y-2.5 p-2.5">
+        <section aria-label={constructionLabel}>
+          <h3 className="mb-1.5 flex items-center gap-1.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-noc-300">
+            <Cable size={11} className="text-sky-300" /> {constructionLabel}
+          </h3>
+          <ul className="space-y-1">
+            {profile.physicalPorts.map((port) => (
+              <li key={port} className="flex gap-1.5 text-[9px] leading-relaxed text-noc-400">
+                <span className="mt-[5px] h-1 w-1 shrink-0 rounded-full bg-sky-400" />
+                <span>{port}</span>
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <section aria-label="Field tips" className="border-t border-noc-700/50 pt-2">
+          <h3 className="mb-1.5 flex items-center gap-1.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-noc-300">
+            <Lightbulb size={11} className="text-amber-300" /> Field tips
+          </h3>
+          <ul className="space-y-1.5">
+            {profile.fieldNotes.map((note, index) => (
+              <li key={note} className="flex gap-1.5 text-[9px] leading-relaxed text-noc-400">
+                <span className="flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-amber-500/10 font-mono text-[8px] text-amber-200">
+                  {index + 1}
+                </span>
+                <span>{note}</span>
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <details className="border-t border-noc-700/50 pt-2">
+          <summary className="flex cursor-pointer list-none items-center gap-1.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-noc-300 marker:hidden">
+            <ShieldCheck size={11} className="text-emerald-300" /> Datasheet context
+          </summary>
+          <dl className="mt-2 space-y-1.5">
+            <div className="flex gap-2 text-[9px] leading-relaxed">
+              <dt className="flex w-[76px] shrink-0 items-start gap-1 text-noc-500">
+                <Thermometer size={10} className="mt-0.5" /> Temperature
+              </dt>
+              <dd className="text-noc-400">{profile.datasheetSnippet.operatingTemp}</dd>
+            </div>
+            <div className="flex gap-2 text-[9px] leading-relaxed">
+              <dt className="flex w-[76px] shrink-0 items-start gap-1 text-noc-500">
+                <Waves size={10} className="mt-0.5" /> Wavelengths
+              </dt>
+              <dd className="text-noc-400">{profile.datasheetSnippet.wavelengths}</dd>
+            </div>
+            <div className="flex gap-2 text-[9px] leading-relaxed">
+              <dt className="w-[76px] shrink-0 text-noc-500">Standards</dt>
+              <dd>
+                <ul className="space-y-1 text-noc-400">
+                  {profile.datasheetSnippet.standards.map((standard) => (
+                    <li key={standard}>{standard}</li>
+                  ))}
+                </ul>
+              </dd>
+            </div>
+          </dl>
+          <p className="mt-2 border-t border-noc-700/40 pt-1.5 text-[8px] leading-relaxed text-noc-500">
+            Values are generic learning context. Verify operating limits, optical specifications, and compliance against the exact product datasheet before deployment.
+          </p>
+        </details>
+      </div>
+    </section>
+  );
+}
+
+export default FieldHardwareCard;
