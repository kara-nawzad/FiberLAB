+}
+
+details[open] .details-chevron {
+  transform: rotate(180deg);
+}
+
+/* Editorial landing system -------------------------------------------------- */
+
+:root {
+  --landing-ground: #fafaf9;
+  --landing-surface: #ffffff;
+  --landing-elevated: #f4f4f5;
+  --landing-ink: #090d16;
+  --landing-muted: #52525b;
+  --landing-subtle: #71717a;
+  --landing-hairline: #e4e4e7;
+  --landing-hairline-strong: #d4d4d8;
+  --landing-cobalt: #2563eb;
+  --landing-downstream: #10b981;
+  --landing-upstream: #06b6d4;
+  --landing-video: #8b5cf6;
+  --landing-fault: #ef4444;
+  --landing-jacket: #facc15;
+  --landing-ease: cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.fiberlab-app-shell {
+  position: relative;
+  width: 100vw;
+  height: 100vh;
+  height: 100dvh;
+  overflow: hidden;
+  background: var(--landing-ground);
+  color: var(--landing-ink);
+  isolation: isolate;
+}
+
+.studio-viewport,
+.landing-viewport {
+  position: absolute;
+  inset: 0;
+  transition: opacity 400ms var(--landing-ease), transform 400ms var(--landing-ease);
+  will-change: opacity, transform;
+}
+
+.studio-viewport {
+  z-index: 10;
+}
+
+.studio-viewport.is-active,
+.landing-viewport.is-active {
+  opacity: 1;
+  transform: translateY(0);
+  pointer-events: auto;
+}
+
+.studio-viewport.is-staged,
+.landing-viewport.is-staged {
+  opacity: 0;
+  transform: translateY(8px);
+  pointer-events: none;
+}
+
+.landing-viewport {
+  z-index: 20;
+}
+
+.landing-page {
+  width: 100%;
+  height: 100%;
+  overflow-x: clip;
+  overflow-y: auto;
+  background:
+    radial-gradient(ellipse at 84% 9%, rgba(16, 185, 129, 0.045), transparent 30rem),
+    var(--landing-ground);
+  color: var(--landing-ink);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  letter-spacing: -0.012em;
+  -webkit-font-smoothing: antialiased;
+}
+
+.landing-page *,
+.landing-page *::before,
+.landing-page *::after {
+  box-sizing: border-box;
+}
+
+.landing-nav-wrap {
+  position: sticky;
+  z-index: 30;
+  top: 0;
+  border-bottom: 1px solid rgba(212, 212, 216, 0.82);
+  background: rgba(250, 250, 249, 0.94);
+  backdrop-filter: blur(16px);
+}
+
+.landing-nav {
+  display: flex;
+  width: min(100% - 64px, 1512px);
+  min-height: 74px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 22px;
+  margin: 0 auto;
+}
+
+.landing-brand {
+  display: inline-flex;
+  min-height: 48px;
+  flex: 0 0 auto;
+  align-items: center;
+  gap: 10px;
+  color: var(--landing-ink);
+  text-decoration: none;
+}
+
+.landing-brand-mark {
+  display: grid;
+  width: 36px;
+  height: 36px;
+  place-items: center;
+  border: 1px solid #bfdbfe;
+  border-radius: 10px;
+  background: #eff6ff;
+  color: var(--landing-cobalt);
+}
+
+.landing-brand-wordmark {
+  display: grid;
+  grid-template-columns: auto auto;
+  align-items: baseline;
+  line-height: 1;
+}
+
+.landing-brand-wordmark strong,
+.landing-brand-wordmark b {
+  font-size: 17px;
+  font-weight: 800;
+  letter-spacing: -0.055em;
+}
+
+.landing-brand-wordmark b {
+  color: var(--landing-cobalt);
+}
+
+.landing-brand-wordmark small {
+  grid-column: 1 / -1;
+  margin-top: 5px;
+  color: var(--landing-subtle);
+  font-size: 8px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+}
+
+.landing-nav-links {
+  display: flex;
+  min-height: 44px;
+  align-items: center;
+  gap: clamp(14px, 2.5vw, 34px);
