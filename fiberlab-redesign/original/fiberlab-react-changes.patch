+import { PillarsGrid } from './PillarsGrid';
+import { SpecsStrip } from './SpecsStrip';
+
+export interface LandingViewProps {
+  onLaunchStudio: () => void;
+  onExploreMissions: () => void;
+  onLoadPreset: (presetId: string) => void;
+  onStartVillaMission: () => void;
+}
