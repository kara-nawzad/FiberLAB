+  }
+
+  .landing-pillar h3 {
+    margin-top: 16px;
+  }
+
+  .landing-pillar > p {
+    font-size: 11px;
+  }
+
+  .landing-formula-graphic,
+  .landing-audit-graphic,
+  .landing-route-graphic {
+    margin-top: 16px;
+    padding-top: 0;
+  }
+
+  .landing-formula-terms {
+    font-size: 8px;
+  }
+
+  .landing-route-graphic {
+    max-height: 94px;
+  }
+
+  .landing-pillar-footnote {
+    margin-top: 9px;
+  }
+
+  .landing-specs-section {
+    gap: 17px;
+    padding: 35px 0 38px;
+  }
+
+  .landing-specs-intro h2 {
+    max-width: 18ch;
+    font-size: 31px;
+  }
+
+  .landing-specs-intro > p:last-child {
+    font-size: 10px;
+  }
+
+  .landing-spec-table {
+    font-size: 8px;
+  }
+
+  .landing-spec-table th,
+  .landing-spec-table td {
+    padding: 9px 6px;
+  }
+
+  .landing-spec-table thead th {
+    font-size: 7px;
+    white-space: normal;
+  }
+
+  .landing-receiver-limits {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .landing-limit-card {
+    grid-template-columns: 22px auto 1fr;
+    min-height: 54px;
+    gap: 6px;
+    padding: 7px 8px;
+  }
+
+  .landing-limit-caption {
+    max-width: 110px;
+  }
+
+  .landing-specs-caveat {
+    font-size: 8px;
+  }
+
+  .landing-footer {
+    grid-template-columns: 1fr auto;
+    gap: 3px 10px;
+    padding: 12px 0 16px;
+  }
+
+  .landing-footer > p {
+    grid-column: 1 / -1;
+    grid-row: 2;
+    font-size: 8px;
+  }
+
+  .landing-footer-link {
+    min-height: 40px;
+    font-size: 9px;
+  }
+}
+
+@media (max-width: 380px) {
+  .landing-main,
+  .landing-footer,
+  .landing-nav {
+    width: calc(100% - 24px);
+  }
+
+  .landing-exhibit-label small {
+    font-size: 9px;
+  }
+
+  .landing-live-indicator {
+    font-size: 6px;
+  }
+
+  .landing-wavelength-chip {
+    gap: 3px;
+    padding-inline: 2px;
+  }
+
+  .landing-wavelength-chip strong {
+    font-size: 7px;
+  }
+
+  .landing-wavelength-chip small {
+    font-size: 6.5px;
+  }
+
+  .landing-spec-table th,
+  .landing-spec-table td {
+    padding-inline: 4px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+
+  .studio-viewport,
+  .landing-viewport {
+    will-change: auto;
+    transition: none !important;
+  }
+
+  .waveguide-ray-pulse {
+    animation: none !important;
+    stroke-dasharray: none;
+  }
+}
