+
+  .landing-hero {
+    gap: 27px;
+    padding: 36px 0 48px;
+  }
+
+  .landing-eyebrow {
+    align-items: flex-start;
+    margin-bottom: 16px;
+    font-size: 8px;
+    letter-spacing: 0.055em;
+  }
+
+  .landing-eyebrow-dot {
+    margin-top: 3px;
+  }
+
+  .landing-display-title {
+    font-size: clamp(43px, 11vw, 62px);
+    line-height: 1;
+  }
+
+  .landing-lede {
+    margin-top: 17px;
+    font-size: 13px;
+    line-height: 1.65;
+  }
+
+  .landing-scope-note {
+    font-size: 9px;
+  }
+
+  .landing-hero-actions {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 8px;
+    margin-top: 19px;
+  }
+
+  .landing-button {
+    width: 100%;
+    min-height: 48px;
+  }
+
+  .landing-quickload {
+    min-height: 44px;
+    font-size: 10px;
+  }
+
+  .landing-alt-quickload {
